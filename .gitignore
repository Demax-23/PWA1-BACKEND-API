# ====================================================================
# .gitignore para Proyecto Backend .NET 9 (TeaLearning API)
# ====================================================================

# --------------------------------------------------------------------
# 1. Compilación y Artefactos de Salida (.NET / C#)
# --------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Bb]uild[Ll]og.*
artifacts/

# --------------------------------------------------------------------
# 2. Archivos de Entorno de Desarrollo (Visual Studio)
# --------------------------------------------------------------------
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.VisualState.xml

# --------------------------------------------------------------------
# 3. Visual Studio Code
# --------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --------------------------------------------------------------------
# 4. JetBrains Rider / Resharper
# --------------------------------------------------------------------
.idea/
*.DotSettings.user
_ReSharper*/

# --------------------------------------------------------------------
# 5. Paquetes NuGet
# --------------------------------------------------------------------
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# --------------------------------------------------------------------
# 6. Bases de Datos Locales (SQL Server / LocalDB / SQLite)
# --------------------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --------------------------------------------------------------------
# 7. Configuración de Entorno y Secretos Sensibles
# --------------------------------------------------------------------
# Archivos con credenciales locales o contraseñas que no deben versionarse
appsettings*.local.json
appsettings.Local.json
appsettings.Production.json
secrets.json
.env
.env.*
!.env.example

# --------------------------------------------------------------------
# 8. Pruebas Unitarias y Cobertura de Código
# --------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.visualstudio.vstest.*
TestResults/
coverage/
*.coverage
*.coveragexml

# --------------------------------------------------------------------
# 9. Logs y Diagnóstico
# --------------------------------------------------------------------
*.log
logs/
[Ll]ogs/
*.dmp
*.stackdump
*.crashdump

# --------------------------------------------------------------------
# 10. Archivos del Sistema Operativo
# --------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
